# Non-secret settings of the "lifeops-api" Edge Function (GitHub Pages build). Applied with
# `npm run deploy:pages-function` (supabase secrets set --env-file), which adds and overwrites names
# but never removes one: a line deleted here keeps its last value on the project until it is unset
# (the deploy names such settings, and its --prune flag unsets them). See PAGES_DEPLOYMENT.md.
# Three values are set separately and are never written to this file: LLM_API_KEY, LLM_BASE_URL
# (it contains the Cloudflare account ID, which stays out of the repository and out of the messages
# visitors see) and LIFEOPS_BACKEND_TOKEN. The deploy stops while one of them is missing: without
# them visitors get no AI answers and "Plan it" cannot use the planner. Names starting with
# SUPABASE_ are reserved by Supabase: the function derives SUPABASE_PUBLISHABLE_KEY and
# SUPABASE_SECRET_KEY from the keys the platform injects.

# Who may call the function, and the app path the server code was built with.
LIFEOPS_ALLOWED_ORIGINS=https://gopalinternship-unibasel.github.io
LIFEOPS_APP_BASE=lifeops-ai

# AI model: the same Cloudflare Workers AI setup as the Vercel deployment.
LLM_MODEL=@cf/zai-org/glm-4.7-flash
LLM_FALLBACK_MODEL=@cf/google/gemma-4-26b-a4b-it
LLM_STRUCTURED_OUTPUT=tools_required
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
LLM_MAX_TOKENS=1200
LLM_MAX_TOKENS_PLAN=2400
# Shorter than Vercel's 60000: Supabase answers 504 when a request sends nothing for 150 s (the
# request idle timeout, on every plan), and a "Plan it" request can wait for the planner and then
# run a chat turn. Separately, the per-worker wall clock is also 150 s on Free (400 s on paid
# plans): a worker lives that long and can serve several requests meanwhile, so a long request on
# a worker that is already warm may be cut short (546) however short these timeouts are; it then
# shows as interrupted and can be tried again.
# Measured on the Vercel edition with the same model (November 2026): a week plan took about 30 s
# and the first-visit briefing about 27 s, so 40 s leaves about 10 s for slower answers. 60000 as
# on Vercel would give more room, but the longest "Plan it" (55 s for the planner, then a main
# model that fails near its limit and the fallback model) could then pass 150 s.
LLM_TIMEOUT_MS=40000
# Unfinished chat turns and plans count as interrupted after this, a little over the 150 s limit.
LIFEOPS_MAX_REQUEST_MS=160000

# The FastAPI planner on Vercel, called server to server with its own token. 55 s covers the
# planner's own 45 s model timeout plus a cold start. The plan request carries a deadline a few
# seconds before that; a planner that is not done by then stores nothing, and "Plan it" uses the
# in-app assistant instead, so a slow plan does not leave a second set of proposals.
LIFEOPS_BACKEND_URL=https://lifeops-planner.vercel.app
LIFEOPS_BACKEND_TIMEOUT_MS=55000
LIFEOPS_BACKEND_DASHBOARD_TIMEOUT_MS=10000

# Demo limits; the counters are in the database, so they are shared with the Vercel deployment.
AI_CHAT_PER_HOUR=20
AI_PLANS_PER_DAY=5
AI_PLANNER_PER_HOUR=6
AI_CALLS_PER_DAY=150
