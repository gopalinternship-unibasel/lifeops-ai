# FastAPI planner service settings. scripts/write-local-env.mjs creates fastapi-backend/.env
# with the local defaults below; edit that file (not this one) to change them.

# ENV: "local" serves /docs; "development" also logs every SQL statement with its values; unset
# or anything else (the hosted planner) serves neither.
ENV=local
DATABASE_URL=sqlite:///./lifeops.db
# Hosted (Vercel + Supabase): a PostgreSQL URL through the pooler, for example
#   DATABASE_URL=postgresql+psycopg://lifeops_planner.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
#   DATABASE_SCHEMA=planner
FRONTEND_ORIGIN=http://localhost:5190

# Any OpenAI-compatible LLM. Leave LLM_BASE_URL empty to use the keyword demo planner.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# llama3.1:8b is the intended model; scripts/write-local-env.mjs writes qwen2.5-3b-4threads
# (Qwen 2.5 3B with 4 threads, ../ollama/qwen2.5-3b-4threads.Modelfile; faster on a CPU).
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=1800
LLM_MAX_TOKENS=1200
# json_schema (Ollama, OpenAI), json_object (providers without schema support) or none (no
# response_format is sent; the planner takes the first JSON object from the answer's text).
LLM_RESPONSE_FORMAT=json_schema
# Hosted demo (Cloudflare Workers AI, as deployed on Vercel since 17 Nov 2026; VERCEL_DEPLOYMENT.md 3.2):
#   LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
#   LLM_API_KEY=the same Workers AI API token as the web app
#   LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
#   LLM_RESPONSE_FORMAT=none   (Cloudflare lists JSON mode only for older models)
#   LLM_TIMEOUT_SECONDS=45
#   LLM_MAX_TOKENS=1200
#   LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Not @cf/zai-org/glm-4.7-flash (the web app's model): asked for plain JSON it spent its whole token
# budget thinking and returned no text, so every plan fell back to the keyword planner.

# Shared secret: the MONDAY app sends it on every /api call. Must match LIFEOPS_BACKEND_TOKEN in ../.env.local.
LIFEOPS_BACKEND_TOKEN=generate-a-long-random-value

# Legacy: OPENAI_API_KEY alone (LLM_BASE_URL empty) selects OpenAI with OPENAI_MODEL.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional: a JSON object added to every model request, for switches only one provider knows.
# On Cloudflare Workers AI this turns the models' thinking off (several times faster):
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# "keyword" always uses the keyword planner, even with a model configured (default "auto").
# PLANNER_MODE=auto

# The planner's own executors (the MONDAY app carries out approved actions itself and only records
# the outcome here). EXECUTION_BACKEND=zapier_mcp needs OPENAI_API_KEY, ZAPIER_MCP_URL and
# ZAPIER_MCP_ALLOWED_TOOLS (comma-separated tool names; nothing else may be called), and an openai
# package with the Responses API (the pinned 1.59.7 has none, so it stays mock here).
# EXECUTION_BACKEND=mock
# Only "mock" exists for the planner's own Gmail and Calendar adapters; another value fails those actions.
# GOOGLE_INTEGRATION_MODE=mock
# AUTONOMOUS_MODE_DEFAULT=false
