# LifeOS 环境变量

# === LLM 提供商：现阶段使用 NVIDIA NIM（OpenAI 兼容协议） ===
# 在 https://build.nvidia.com 申请 API Key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
# 可选：覆盖默认模型与 endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 默认走 Mistral Medium 3.5 128B（https://build.nvidia.com/mistralai/mistral-medium-3.5-128b）
NVIDIA_MODEL=mistralai/mistral-medium-3.5-128b
# Mistral 只支持 none / high。high 会让总耗时涨到 13 分钟级别，demo 千万别开。
# 默认 none（首 token ~0.5s，总耗时 ~70s）。
NVIDIA_REASONING_EFFORT=none

# === 备用：Anthropic（适配层已预留接口，目前未启用） ===
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# === 通用：选择当前激活的 provider，nvidia | anthropic ===
LLM_PROVIDER=nvidia
