# Local development: scripts/write-local-env.mjs writes .env.local from `supabase status`.
# This file documents every variable for hosted deployments.

# Public Supabase values (embedded in the browser bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Set true only for a controlled demo; requires Anonymous Sign-Ins in Supabase.
VITE_ENABLE_ANONYMOUS_DEMO=false
# Show "Continue with Google" (Supabase Google login). Needs the Google provider enabled in Supabase Auth.
VITE_ENABLE_GOOGLE_SIGNIN=false

# Server-side Supabase values
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
# Legacy fallback only; leave unset when using SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# AI provider (server only). Any OpenAI-compatible chat-completions API.
#   Local Ollama (default):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1:8b (intended model)
#                            or LLM_MODEL=qwen2.5:3b (local default of scripts/write-local-env.mjs: faster on a CPU)
#   Hugging Face router:     LLM_BASE_URL=https://router.huggingface.co/v1  LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
#   OpenAI:                  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
#   Google Gemini:           LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
# Optional per-role models: LLM_MODEL_CHAT, LLM_MODEL_PLAN, LLM_MODEL_DRAFT. Optional LLM_FALLBACK_MODEL (or "none").
# tools = OpenAI function calling; json_schema = constrained JSON output (recommended for Ollama).
LLM_STRUCTURED_OUTPUT=json_schema
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=1200
# A 7-day plan needs more room than a chat answer.
LLM_MAX_TOKENS_PLAN=2400
# Legacy: with LLM_BASE_URL unset, HUGGINGFACE_API_KEY alone selects the Hugging Face router.
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FastAPI planner service (fastapi-backend/). "off" disables it; the dashboard then uses the in-app assistant.
LIFEOPS_BACKEND_URL=http://127.0.0.1:8010
# Shared secret; must equal LIFEOPS_BACKEND_TOKEN in fastapi-backend/.env.
LIFEOPS_BACKEND_TOKEN=generate-a-long-random-value

# Google OAuth client used for Gmail + Calendar connector (server only)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only when the public URL differs from the server's own origin.
# GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/public/google/callback

# Generate a unique secret of at least 32 characters, for example:
# openssl rand -base64 48
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-long-random-secret-at-least-32-characters
